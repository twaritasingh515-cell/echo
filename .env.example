# -----------------------------------------------------------------------------
# This file is a TEMPLATE. Copy it to .env.local and fill in real values there.
# .env.local is git-ignored — never commit real keys, including organizer-issued
# ones. Everything below is a placeholder; nothing here is a working secret.
#   cp .env.example .env.local
# -----------------------------------------------------------------------------

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Rime TTS (https://rime.ai) --------------------------------------------
# Optional. If RIME_API_KEY is omitted, the system falls back to a
# high-fidelity browser-neural voice with British prosody automatically —
# the app runs fine without it.
#
# If your hackathon/event organizer issued you a Rime key + config, paste
# THEIR values here in your local .env.local only (never in .env.example,
# never committed). Leave these as placeholders in version control.

# RIME_API_KEY: Bearer token for https://users.rime.ai/v1/rime-tts
RIME_API_KEY="MY_RIME_API_KEY"

# RIME_API_BASE_URL: Override only if the organizer gave you a different
# endpoint (e.g. a proxied/regional URL). Defaults to Rime's public API.
RIME_API_BASE_URL="https://users.rime.ai/v1/rime-tts"

# RIME_MODEL_ID: Default Rime model if a request doesn't specify one.
# Known values used by this app: "coda" (default, low-latency English),
# "mistv3" (fast conversational), "arcana" (Hindi/English, auto-selected
# for Hindi/Hinglish text regardless of this setting).
RIME_MODEL_ID="coda"

# RIME_SPEAKER: Default speaker/voice if a request doesn't specify one.
# Valid values: albion, victoria, astra, celeste, orion, lyra, masonry, luna
RIME_SPEAKER="albion"

